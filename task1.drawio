        <mxCell id="p2-r1b" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p2-s1-1" target="p2-s1-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-r2a" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p2-s2-1" target="p2-s2-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-r2b" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p2-s2-1" target="p2-s2-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-note" value="&lt;b&gt;Как работает:&lt;/b&gt;&lt;br&gt;• Каждый шард — replica set из трёх нод: одна primary и две secondary. Secondary-ноды копируют данные с primary через oplog.&lt;br&gt;• Если primary упадёт, оставшиеся ноды выберут новую primary, и шард продолжит работать.&lt;br&gt;• mongos_router сам находит текущую primary в каждом replica set; сплошные стрелки идут к группе, а не к конкретной ноде." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-legend" value="&lt;b&gt;Обозначения:&lt;/b&gt;&lt;br&gt;——▶ сетевой запрос&lt;br&gt;- - -▶ репликация primary → secondary&lt;br&gt;пунктирная рамка — replica set" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="610" width="280" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
