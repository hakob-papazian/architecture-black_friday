        <mxCell id="p1-shard2" value="shard2&lt;br&gt;&lt;i&gt;mongod --shardsvr&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
