          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e4" value="чтение / запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="p4-router" target="p4-g-shard2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-r1a" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p4-s1-1" target="p4-s1-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-r1b" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p4-s1-1" target="p4-s1-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-r2a" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p4-s2-1" target="p4-s2-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-r2b" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p4-s2-1" target="p4-s2-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-note" value="&lt;b&gt;Как работает масштабирование:&lt;/b&gt;&lt;br&gt;• Пользователь обращается только к api_gateway — единой точке входа (например, APISIX или Traefik с поддержкой Consul).&lt;br&gt;• Каждый инстанс pymongo-api при старте регистрируется в Consul как сервис pymongo-api, Consul периодически проверяет его health check.&lt;br&gt;• api_gateway получает из Consul актуальный список здоровых инстансов и распределяет между ними запросы (round robin). Новые инстансы попадают в балансировку автоматически, упавшие или удалённые — исключаются.&lt;br&gt;• Consul развёрнут кластером из трёх серверов: при отказе одного кластер продолжает работать.&lt;br&gt;• Все инстансы pymongo-api используют общий redis и общий mongos_router, поэтому их можно добавлять и удалять без потери данных и кеша." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="600" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p4-legend" value="&lt;b&gt;Обозначения:&lt;/b&gt;&lt;br&gt;——▶ сетевой запрос&lt;br&gt;- - -▶ репликация / health check&lt;br&gt;◀- - -▶ консенсус Raft между серверами Consul&lt;br&gt;пунктирная рамка — группа (replica set, кластер, пул инстансов)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="620" width="280" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
