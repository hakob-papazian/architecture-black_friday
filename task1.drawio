        <mxCell id="p5-static" value="static_storage&lt;br&gt;&lt;i&gt;S3 Object Storage (origin)&lt;/i&gt;&lt;br&gt;JS, CSS, изображения товаров" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="165" y="760" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-u1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10739E;" edge="1" parent="1" source="p5-user-msk" target="p5-cdn-msk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-u2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10739E;" edge="1" parent="1" source="p5-user-nsk" target="p5-cdn-nsk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-u3" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10739E;" edge="1" parent="1" source="p5-user-vvo" target="p5-cdn-vvo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-origin" value="статика: origin pull&lt;br&gt;при промахе кеша CDN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0e8088;" edge="1" parent="1" source="p5-g-cdn" target="p5-static">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-dyn" value="динамические запросы&lt;br&gt;(API, без кеширования в CDN)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10739E;" edge="1" parent="1" source="p5-g-cdn" target="p5-gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-note-cdn" value="&lt;b&gt;Как работает CDN:&lt;/b&gt;&lt;br&gt;• DNS направляет пользователя на ближайший к нему edge-сервер CDN.&lt;br&gt;• Статический контент магазина (JS, CSS, изображения товаров) хранится в static_storage — это origin для CDN. Edge-сервер отдаёт статику из своего кеша, а при промахе забирает её из static_storage и кеширует.&lt;br&gt;• Динамические запросы (API) CDN не кеширует и проксирует в api_gateway." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="840" width="520" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>