        <mxCell id="p1-e3" value="чтение / запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p1-router" target="p1-shard1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e4" value="чтение / запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p1-router" target="p1-shard2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" value="&lt;b&gt;Как работает:&lt;/b&gt;&lt;br&gt;• pymongo-api подключается только к mongos_router.&lt;br&gt;• mongos_router берёт из configSrv карту распределения чанков и отправляет запрос на нужный шард.&lt;br&gt;• Коллекция somedb.helloDoc шардируется по ключу { name: &quot;hashed&quot; }, поэтому данные и нагрузка делятся между shard1 и shard2 примерно поровну." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="700" height="100" as="geometry" />
        </mxCell>
