        <mxCell id="p3-r2a" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p3-s2-1" target="p3-s2-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-r2b" value="репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2D7600;" edge="1" parent="1" source="p3-s2-1" target="p3-s2-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-note" value="&lt;b&gt;Как работает кеш:&lt;/b&gt;&lt;br&gt;• pymongo-api получает переменную REDIS_URL=redis://redis:6379 и включает fastapi-cache с бэкендом Redis.&lt;br&gt;• Эндпоинт GET /{collection}/users кешируется на 60 секунд: при попадании в кеш ответ отдаётся из redis, а запрос до mongos_router и шардов не доходит.&lt;br&gt;• При промахе кеша запрос идёт в MongoDB через mongos_router, результат сохраняется в redis." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-legend" value="&lt;b&gt;Обозначения:&lt;/b&gt;&lt;br&gt;——▶ сетевой запрос&lt;br&gt;- - -▶ репликация primary → secondary&lt;br&gt;пунктирная рамка — replica set" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="610" width="280" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
